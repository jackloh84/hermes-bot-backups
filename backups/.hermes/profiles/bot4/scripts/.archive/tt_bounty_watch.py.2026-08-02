#!/usr/bin/env python3
"""Tenstorrent bounty watcher — runs daily 09:00 SGT.

Scans tenstorrent/tt-metal for open bounty issues, filters:
- Created in last 24h (new)
- OR unassigned + not in last-state (newly unassigned / first-time-seen)

Sends Telegram alert to Jack when something new is found, plus
writes JSON state for trend tracking.

Usage:
    python3 tt_bounty_watch.py              # normal run (saves state, alerts if new)
    python3 tt_bounty_watch.py --dry-run    # scan only, no TG message
    python3 tt_bounty_watch.py --force      # re-alert on all currently open unassigned
"""

import argparse, json, os, re, sys, time, urllib.request
from datetime import datetime, timezone

GITHUB_API = "https://api.github.com/search/issues"
REPO = "tenstorrent/tt-metal"
STATE_FILE = "/home/ubuntu/.hermes/profiles/bot4/state/tenstorrent_bounties.json"
LAST_ALERT_FILE = "/home/ubuntu/.hermes/profiles/bot4/state/tenstorrent_last_alert.txt"
TG_BOT_TOKEN_FILE = "/home/ubuntu/.hermes/profiles/cs-bot/.env"
JACK_CHAT_ID = "366983738"  # Jack's personal TG chat id (DM)


def http_get(url, headers=None, timeout=10):
    req = urllib.request.Request(url, headers={**(headers or {}), "User-Agent": "BizBot-tt-watch/1.0"})
    return urllib.request.urlopen(req, timeout=timeout).read()


def fetch_bounties():
    """Returns list of open bounty issues with full metadata."""
    q = f"repo:{REPO}+label:bounty+is:open"
    url = f"{GITHUB_API}?q={q}&per_page=50"
    data = json.loads(http_get(url))
    out = []
    for it in data.get("items", []):
        m = re.search(r'\$([\d,]+)', it.get("title", ""))
        amt = int(m.group(1).replace(",", "")) if m else 0
        asn = [a.get("login") for a in it.get("assignees", [])]
        out.append({
            "num": it["number"],
            "title": it["title"],
            "amount": amt,
            "assignees": asn,
            "created": it["created_at"],
            "updated": it["updated_at"],
            "comments": it.get("comments", 0),
            "url": it["html_url"],
            "diff": next((l["name"] for l in it.get("labels", []) if "difficulty" in l["name"]), "?"),
        })
    return out


def load_state():
    if os.path.exists(STATE_FILE):
        try:
            return json.load(open(STATE_FILE))
        except Exception:
            pass
    return {"seen": {}}


def save_state(state):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)


def get_tg_token():
    """Load cs-bot's Telegram bot token."""
    p = TG_BOT_TOKEN_FILE
    if not os.path.exists(p):
        return None
    for line in open(p):
        if line.startswith("TELEGRAM_BOT_TOKEN="):
            return line.split("=", 1)[1].strip().strip('"').strip("'")
    return None


def send_tg(token, chat_id, text):
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    body = json.dumps({
        "chat_id": chat_id,
        "text": text,
        "parse_mode": "Markdown",
        "disable_web_page_preview": True,
    }).encode()
    req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"})
    try:
        r = urllib.request.urlopen(req, timeout=10)
        return r.status
    except Exception as e:
        print(f"TG send error: {e}", file=sys.stderr)
        return None


def format_alert(new_items, all_unassigned):
    """Build the Telegram message — short, actionable."""
    now = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    lines = [
        f"🚨 *Tenstorrent bounty alert* — {now}",
        "",
    ]
    if new_items:
        lines.append(f"*NEW / changed ({len(new_items)}):*")
        for b in sorted(new_items, key=lambda x: -x["amount"]):
            asn = ", ".join(b["assignees"]) if b["assignees"] else "🟢 *UNASSIGNED*"
            lines.append(f"  • ${b['amount']:,} #{b['num']} | {b['diff'].split('/')[-1]} | → {asn}")
            lines.append(f"    {b['title'][:80]}")
    else:
        lines.append("*No new bounties in last 24h.*")
    if all_unassigned:
        lines.append("")
        lines.append(f"*All open unassigned ({len(all_unassigned)}):*")
        for b in sorted(all_unassigned, key=lambda x: -x["amount"]):
            lines.append(f"  • ${b['amount']:,} #{b['num']} | {b['diff'].split('/')[-1]}")
            lines.append(f"    {b['title'][:80]}")
            lines.append(f"    {b['url']}")
        if new_items:
            lines.append("")
            lines.append("👉 Claim from your `jackloh84` account now (Biz Bot has the fix ready for #50465).")
    return "\n".join(lines)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--force", action="store_true", help="alert on all current unassigned")
    args = ap.parse_args()

    bounties = fetch_bounties()
    state = load_state()
    seen = state.setdefault("seen", {})
    now_iso = datetime.now(timezone.utc).isoformat()

    # Update seen map with current state of each issue
    new_or_changed = []
    for b in bounties:
        key = str(b["num"])
        prev = seen.get(key, {})
        cur = {
            "amount": b["amount"], "assignees": b["assignees"],
            "updated": b["updated"], "title": b["title"], "diff": b["diff"],
        }
        if args.force:
            new_or_changed.append(b)
        elif prev == {}:
            # First time seeing this issue — but only flag if it's NEW (<48h)
            age_hours = (datetime.now(timezone.utc) - datetime.fromisoformat(b["created"].replace("Z", "+00:00"))).total_seconds() / 3600
            if age_hours < 48:
                new_or_changed.append(b)
        elif b["assignees"] != prev.get("assignees") or b["updated"] != prev.get("updated"):
            new_or_changed.append(b)
        seen[key] = cur

    unassigned = [b for b in bounties if not b["assignees"]]

    state["last_run"] = now_iso
    state["open_count"] = len(bounties)
    state["unassigned_count"] = len(unassigned)
    save_state(state)

    print(f"[{now_iso}] scanned {len(bounties)} open bounties, {len(unassigned)} unassigned, {len(new_or_changed)} changed")

    if args.dry_run:
        if new_or_changed:
            print("\n=== WOULD ALERT ===")
            for b in new_or_changed:
                asn = b["assignees"] or "UNASSIGNED"
                print(f"  ${b['amount']} #{b['num']} | {b['diff']} | → {asn}")
        if unassigned:
            print(f"\n=== {len(unassigned)} unassigned ===")
            for b in sorted(unassigned, key=lambda x: -x["amount"]):
                print(f"  ${b['amount']} #{b['num']} | {b['diff']} | {b['title'][:70]}")
        return

    # Always alert with the full unassigned list (once per day max) + any changes
    msg = format_alert(new_or_changed, unassigned)
    token = get_tg_token()
    if not token:
        print("ERROR: no TG token found", file=sys.stderr)
        sys.exit(1)
    status = send_tg(token, JACK_CHAT_ID, msg)
    if status == 200:
        print(f"TG alert sent (chat {JACK_CHAT_ID})")
        with open(LAST_ALERT_FILE, "w") as f:
            f.write(now_iso)
    else:
        print(f"TG alert failed: {status}", file=sys.stderr)


if __name__ == "__main__":
    main()